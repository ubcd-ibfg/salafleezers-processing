# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# None of these are required. The GUI works out of the box: drag files or a
# folder into the browser and they land in your own upload workspace, no
# server-side configuration needed. Everything below is for hardening a
# shared-lab deployment.

# Host port the GUI (Svelte SPA + API) is published on.
# The GUI is reachable at http://localhost:${SFZ_PORT} once the container
# is running.
SFZ_PORT=8765

# Optional: base path the GUI is served under, e.g. "/salafleezer" to reach
# it at http://localhost:${SFZ_PORT}/salafleezer/ instead of the root --
# useful behind a reverse proxy that forwards the path through unstripped
# (see src/salafleezers/web/app.py's resolve_frontend_base_path). Leave
# unset/blank for the default root deployment. This is baked into the built
# frontend at image-build time, so changing it requires a rebuild:
#   docker compose up --build
#FRONTEND_BASE_PATH=

# Optional: comma-separated CORS/WebSocket-origin allowlist, needed whenever
# the GUI is reached through a reverse proxy under a hostname other than
# localhost/127.0.0.1 (the built-in defaults), e.g. "https://lab.example.org".
# Without it, the app's own WebSocket origin check (see
# src/salafleezers/web/ws/session.py) rejects the live filter/crop/measure
# socket even though page load and REST calls still work fine.
#SFZ_ALLOW_ORIGIN=

# Optional: set to enable the shared-secret auth gate for a shared-lab
# deployment (see src/salafleezers/web/auth.py). Everyone with the token is
# treated as the SAME user -- authenticates, but does not distinguish people.
# Leave unset/blank for single-user local-first use.
#SFZ_AUTH_TOKEN=

# Optional: name of a header set by an authenticating reverse proxy
# (oauth2-proxy, Authelia, Cloudflare Access, etc.) carrying the end user's
# identity, e.g. X-Auth-Request-Email. When set, each distinct header value
# gets its own isolated sessions and upload workspace, instead of everyone
# sharing one principal under SFZ_AUTH_TOKEN. Only set this if the proxy in
# front of this container OVERWRITES the header rather than forwarding
# whatever the client sent -- otherwise a client can claim to be anyone.
#SFZ_TRUSTED_USER_HEADER=

# Optional: per-file and per-user total caps on browser uploads (bytes).
# Defaults: 1 GiB per file, 20 GiB per user.
#SFZ_MAX_UPLOAD_BYTES=1073741824
#SFZ_MAX_WORKSPACE_BYTES=21474836480

# Optional: ceiling on parsed trace arrays held in memory across all
# sessions (bytes). Default: 4 GiB. Arrays are a cache in front of durable
# storage, so lowering this trades memory for re-parsing on cache misses.
#SFZ_MAX_CACHE_BYTES=4294967296

# Optional legacy flow: reach files already on this host by server path
# instead of uploading them (e.g. for scripted workflows). See
# docker-compose.override.yml.example -- copy it to
# docker-compose.override.yml and set SFZ_DATA_DIR there to enable it.
#SFZ_DATA_DIR=/path/to/your/trace-files
